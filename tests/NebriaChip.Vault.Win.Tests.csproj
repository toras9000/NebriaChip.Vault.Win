  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\NebriaChip.Vault.Win.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

</Project>
