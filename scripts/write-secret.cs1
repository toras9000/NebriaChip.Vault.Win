#!/usr/bin/env -S dotnet run --file
#:property TargetFramework=net10.0-windows7.0
#:project ../src/NebriaChip.Vault.Win.csproj
using NebriaChip.Vault.Win;

Console.WriteLine("Enter secret");
Console.Write(">");
var input = Console.ReadLine();
if (string.IsNullOrWhiteSpace(input)) return;

var adapter = new PersistVaultAdapter();
adapter.WriteGenericText("NebriaChip-TestScript", input);
